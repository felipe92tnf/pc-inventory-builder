generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PartCategory {
  CPU
  GPU
  MOTHERBOARD
  RAM
  STORAGE
  PSU
  CASE
  COOLER
  FAN
  NETWORK
  MONITOR
  PERIPHERAL
  OS
  LABOR
  OTHER
}

enum PartCondition {
  NEW
  USED
  REFURBISHED
}

enum InventoryKind {
  PART
  PREBUILT_PC
}

enum BuildStatus {
  DRAFT
  CONFIRMED
  SOLD
  PENDING_PICKUP
  PENDING_PAYMENT
  RESERVED
}

enum ServiceType {
  SPARE_PART_SALE
  PC_CLEANING
  FORMATTING
  OS_INSTALLATION
  DIAGNOSTIC
  THERMAL_PASTE_CHANGE
  PARTIAL_ASSEMBLY
  HOME_SERVICE
  OTHER
}

enum ServiceStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum SaleStatus {
  COMPLETED
  REVERTED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  PENDING_PAYMENT
}

enum QuoteItemType {
  INVENTORY_PART
  MANUAL_ITEM
  SERVICE
  EXTRA_TEMPLATE
}

/// Notas de ficha de cliente (clave deduplicada en aplicacion: telefono + nombre).
/// @deprecated Preferir `Customer.notes`; se mantiene por compatibilidad.
model CustomerProfile {
  id         String   @id @default(cuid())
  lookupKey  String   @unique
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Cliente reutilizable (nombre + telefono como identidad; lookupKey para deduplicar).
model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @default("")
  email     String?
  notes     String?
  lookupKey String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotes   Quote[]
  services Service[]
  builds   Build[]
  sales    Sale[]

  @@index([name])
  @@index([phone])
}

/// Plantilla de extra / servicio sin stock (SO, instalacion, drivers, packs, etc.).
model ExtraTemplate {
  id                 String   @id @default(cuid())
  name               String
  description        String   @default("")
  defaultCostPrice   Decimal  @db.Decimal(12, 2)
  defaultSalePrice   Decimal  @db.Decimal(12, 2)
  category           String   @default("")
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  buildLines        BuildExtraLine[]
  quoteItems        QuoteItem[]
  serviceExtraLines ServiceExtraLine[]

  @@index([active])
  @@index([category])
  @@index([name])
}

/// Plantilla reutilizable (catalogo). Las filas de inventario `Part` pueden enlazar aqui.
model PartCatalog {
  id               String       @id @default(cuid())
  sku              String?
  name             String
  category         PartCategory
  brand            String       @default("")
  model            String       @default("")
  defaultCostPrice Decimal      @db.Decimal(12, 2)
  defaultSalePrice Decimal      @db.Decimal(12, 2)
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  parts Part[]

  @@unique([sku])
  @@index([name])
  @@index([category])
}

model Part {
  id              String         @id @default(cuid())
  inventoryKind   InventoryKind  @default(PART)
  name            String
  /// Obligatorio para PART; null para PC premontado.
  category        PartCategory?
  condition       PartCondition
  costPrice       Decimal
  salePrice       Decimal
  stock           Int            @default(0)
  notes           String?
  /// Componentes / especificaciones (principalmente PREBUILT_PC).
  description     String         @default("")
  /// Si la pieza viene del catalogo, referencia a la plantilla.
  catalogPartId   String?
  /// PC ensamblado en taller: unidad vinculada al montaje (1:1) al confirmar montaje por piezas.
  assembledFromBuildId String? @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  catalogPart            PartCatalog? @relation(fields: [catalogPartId], references: [id], onDelete: SetNull)
  assembledFromBuild     Build?         @relation("AssembledInventoryPart", fields: [assembledFromBuildId], references: [id], onDelete: SetNull)
  buildItems             BuildPartItem[]
  sparePartServices      Service[]             @relation("SparePart")
  serviceSparePartLines  ServiceSparePartLine[]
  quoteItems             QuoteItem[]

  @@index([category])
  @@index([condition])
  @@index([name])
  @@index([inventoryKind])
  @@index([catalogPartId])
}

model Service {
  id                     String          @id @default(cuid())
  type                   ServiceType
  title                  String
  customerId             String?
  customerName           String
  customerPhone          String
  customerEmail          String?
  description            String          @default("")
  selectedPartId         String?
  quantity               Int?
  costPrice              Decimal
  salePrice              Decimal
  profit                 Decimal
  isHomeService          Boolean         @default(false)
  homeServiceAddress     String?
  /// Suplemento opcional por desplazamiento (informativo; puede incluirse ya en salePrice).
  homeServiceSupplement  Decimal?
  serviceDate            DateTime
  status                 ServiceStatus   @default(PENDING)
  paymentMethod          String?
  notes                  String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  customer       Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  selectedPart   Part?                  @relation("SparePart", fields: [selectedPartId], references: [id], onDelete: SetNull)
  sparePartLines ServiceSparePartLine[]
  extraLines     ServiceExtraLine[]

  @@index([customerId])
  @@index([type])
  @@index([status])
  @@index([serviceDate])
}

model ServiceSparePartLine {
  id        String @id @default(cuid())
  serviceId String
  partId    String
  quantity  Int

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  part    Part    @relation(fields: [partId], references: [id], onDelete: Restrict)

  @@index([serviceId])
  @@index([partId])
}

model ServiceExtraLine {
  id              String  @id @default(cuid())
  serviceId       String
  extraTemplateId String?
  name            String
  description     String  @default("")
  quantity        Int     @default(1)
  unitCost        Decimal @db.Decimal(12, 2)
  unitSalePrice   Decimal @db.Decimal(12, 2)

  service       Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  extraTemplate ExtraTemplate? @relation(fields: [extraTemplateId], references: [id], onDelete: SetNull)

  @@index([serviceId])
  @@index([extraTemplateId])
}

model Build {
  id                 String          @id @default(cuid())
  name               String
  customerId         String?
  /// Cliente (ficha del montaje; la venta puede ampliar o coincidir al registrar cobro).
  customerName       String?
  customerPhone      String?
  customerEmail      String?
  notes              String?
  status             BuildStatus     @default(DRAFT)
  confirmedAt        DateTime?
  /// Venta total manual; si es null se usa la suma de precios de venta de las piezas.
  saleTotalOverride  Decimal?
  /// Reserva (estado RESERVED): importe ya cobrado.
  reservationDeposit       Decimal?    @db.Decimal(12, 2)
  /// Reserva: pendiente hasta completar venta.
  reservationRemaining     Decimal?    @db.Decimal(12, 2)
  /// Pendiente de pago: importe ya cobrado.
  pendingPaymentPaid       Decimal?    @db.Decimal(12, 2)
  /// Pendiente de pago: falta por cobrar.
  pendingPaymentRemaining  Decimal?    @db.Decimal(12, 2)
  /// Mes de imputacion de anticipos (reserva / pago parcial) en resumen de ventas.
  partialAccruedAt     DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  customer   Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items      BuildPartItem[]
  extraLines BuildExtraLine[]
  sales      Sale[]

  convertedFromQuote Quote? @relation("QuoteConvertedBuild")

  assembledInventoryPart Part? @relation("AssembledInventoryPart")

  @@index([customerId])
  @@index([status])
  @@index([name])
}

model Sale {
  id             String     @id @default(cuid())
  buildId        String
  status         SaleStatus @default(COMPLETED)
  revertedAt     DateTime?
  customerId     String?
  customerName   String
  customerPhone  String
  customerEmail  String?
  finalSalePrice Decimal
  totalCost      Decimal
  profit         Decimal
  soldAt         DateTime @default(now())
  paymentMethod  String?
  warrantyMonths Int?
  notes          String?
  /// Null = cobrado pero pendiente de entrega al cliente (sigue en ingresos; no en PCs entregados).
  pickupConfirmedAt DateTime?
  /// Venta creada por importación Excel (histórico); no modifica inventario.
  isImported     Boolean  @default(false)
  /// Mismo valor para todas las filas de una misma confirmación de importación.
  importBatchId  String?
  /// Momento en que se confirmó la importación (compartido por el lote).
  importedAt     DateTime?
  /// Nombre del archivo importado (compartido por el lote).
  importFileName String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  build    Build     @relation(fields: [buildId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([buildId])
  @@index([customerId])
  @@index([soldAt])
  @@index([importBatchId])
  @@index([status])
}

model BuildPartItem {
  id            String  @id @default(cuid())
  buildId       String
  partId        String
  quantity      Int     @default(1)
  /// Coste unitario snapshot al anadir la linea (no sigue cambios del inventario).
  unitCost      Decimal
  /// Precio de venta unitario para esta linea del montaje (independiente del inventario).
  unitSalePrice Decimal

  build Build @relation(fields: [buildId], references: [id], onDelete: Cascade)
  part  Part  @relation(fields: [partId], references: [id], onDelete: Restrict)

  @@unique([buildId, partId])
  @@index([buildId])
  @@index([partId])
}

model BuildExtraLine {
  id              String  @id @default(cuid())
  buildId         String
  extraTemplateId String?
  name            String
  description     String  @default("")
  quantity        Int     @default(1)
  unitCost        Decimal @db.Decimal(12, 2)
  unitSalePrice   Decimal @db.Decimal(12, 2)

  build         Build          @relation(fields: [buildId], references: [id], onDelete: Cascade)
  extraTemplate ExtraTemplate? @relation(fields: [extraTemplateId], references: [id], onDelete: SetNull)

  @@index([buildId])
  @@index([extraTemplateId])
}

model Quote {
  id              String       @id @default(cuid())
  quoteNumber     Int          @unique @default(autoincrement())
  customerId      String?
  customerName    String
  customerPhone   String?
  customerEmail   String?
  title           String
  description     String?
  status          QuoteStatus  @default(DRAFT)
  validUntil      DateTime?
  subtotal        Decimal
  discountAmount  Decimal      @default(0)
  total           Decimal
  /// Importe total acordado a cobrar; si es null se usa `total` del presupuesto (lineas + descuento).
  paymentTotal    Decimal?     @db.Decimal(12, 2)
  amountPaid      Decimal      @default(0) @db.Decimal(12, 2)
  /// Fecha de pago acordada o ultimo pago registrado (solo dia en UI).
  paymentDate     DateTime?
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  convertedToBuildId String?   @unique
  convertedAt        DateTime?

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    QuoteItem[]

  convertedBuild Build? @relation("QuoteConvertedBuild", fields: [convertedToBuildId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model QuoteItem {
  id              String        @id @default(cuid())
  quoteId         String
  partId          String?
  extraTemplateId String?
  itemType        QuoteItemType
  name            String
  description     String?
  quantity        Int
  unitCost        Decimal?
  unitSalePrice   Decimal
  total           Decimal
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  quote         Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  part          Part?          @relation(fields: [partId], references: [id], onDelete: SetNull)
  extraTemplate ExtraTemplate? @relation(fields: [extraTemplateId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([partId])
  @@index([extraTemplateId])
}