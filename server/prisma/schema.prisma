generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PartCategory {
  CPU
  GPU
  MOTHERBOARD
  RAM
  STORAGE
  PSU
  CASE
  COOLER
  FAN
  NETWORK
  MONITOR
  PERIPHERAL
  OS
  LABOR
  OTHER
}

enum PartCondition {
  NEW
  USED
  REFURBISHED
}

enum InventoryKind {
  PART
  PREBUILT_PC
}

enum BuildStatus {
  DRAFT
  CONFIRMED
  SOLD
}

enum ServiceType {
  SPARE_PART_SALE
  PC_CLEANING
  FORMATTING
  OS_INSTALLATION
  DIAGNOSTIC
  THERMAL_PASTE_CHANGE
  PARTIAL_ASSEMBLY
  HOME_SERVICE
  OTHER
}

enum ServiceStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum QuoteItemType {
  INVENTORY_PART
  MANUAL_ITEM
  SERVICE
}

model Part {
  id              String         @id @default(cuid())
  inventoryKind   InventoryKind  @default(PART)
  name            String
  /// Obligatorio para PART; null para PC premontado.
  category        PartCategory?
  condition       PartCondition
  costPrice       Decimal
  salePrice       Decimal
  stock           Int            @default(0)
  notes           String?
  /// Componentes / especificaciones (principalmente PREBUILT_PC).
  description     String         @default("")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  buildItems          BuildPartItem[]
  sparePartServices   Service[]       @relation("SparePart")
  quoteItems          QuoteItem[]

  @@index([category])
  @@index([condition])
  @@index([name])
  @@index([inventoryKind])
}

model Service {
  id                     String          @id @default(cuid())
  type                   ServiceType
  title                  String
  customerName           String
  customerPhone          String
  customerEmail          String?
  description            String          @default("")
  selectedPartId         String?
  quantity               Int?
  costPrice              Decimal
  salePrice              Decimal
  profit                 Decimal
  isHomeService          Boolean         @default(false)
  homeServiceAddress     String?
  /// Suplemento opcional por desplazamiento (informativo; puede incluirse ya en salePrice).
  homeServiceSupplement  Decimal?
  serviceDate            DateTime
  status                 ServiceStatus   @default(PENDING)
  paymentMethod          String?
  notes                  String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  selectedPart Part? @relation("SparePart", fields: [selectedPartId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([status])
  @@index([serviceDate])
}

model Build {
  id                 String          @id @default(cuid())
  name               String
  notes              String?
  status             BuildStatus     @default(DRAFT)
  confirmedAt        DateTime?
  /// Venta total manual; si es null se usa la suma de precios de venta de las piezas.
  saleTotalOverride  Decimal?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  items BuildPartItem[]
  sale  Sale?

  convertedFromQuote Quote? @relation("QuoteConvertedBuild")

  @@index([status])
  @@index([name])
}

model Sale {
  id             String   @id @default(cuid())
  buildId        String   @unique
  customerName   String
  customerPhone  String
  customerEmail  String?
  finalSalePrice Decimal
  totalCost      Decimal
  profit         Decimal
  soldAt         DateTime @default(now())
  paymentMethod  String?
  warrantyMonths Int?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  build Build @relation(fields: [buildId], references: [id], onDelete: Cascade)

  @@index([soldAt])
}

model BuildPartItem {
  id            String  @id @default(cuid())
  buildId       String
  partId        String
  quantity      Int     @default(1)
  /// Coste unitario snapshot al anadir la linea (no sigue cambios del inventario).
  unitCost      Decimal
  /// Precio de venta unitario para esta linea del montaje (independiente del inventario).
  unitSalePrice Decimal

  build Build @relation(fields: [buildId], references: [id], onDelete: Cascade)
  part  Part  @relation(fields: [partId], references: [id], onDelete: Restrict)

  @@unique([buildId, partId])
  @@index([buildId])
  @@index([partId])
}

model Quote {
  id              String       @id @default(cuid())
  quoteNumber     Int          @unique @default(autoincrement())
  customerName    String
  customerPhone   String?
  customerEmail   String?
  title           String
  description     String?
  status          QuoteStatus  @default(DRAFT)
  validUntil      DateTime?
  subtotal        Decimal
  discountAmount  Decimal      @default(0)
  total           Decimal
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  convertedToBuildId String?   @unique
  convertedAt        DateTime?

  items QuoteItem[]

  convertedBuild Build? @relation("QuoteConvertedBuild", fields: [convertedToBuildId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
}

model QuoteItem {
  id             String        @id @default(cuid())
  quoteId        String
  partId         String?
  itemType       QuoteItemType
  name           String
  description    String?
  quantity       Int
  unitCost       Decimal?
  unitSalePrice  Decimal
  total          Decimal
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  part  Part? @relation(fields: [partId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([partId])
}